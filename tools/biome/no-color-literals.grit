engine biome(1.0)
language js(typescript, jsx)

or { JsStringLiteralExpression(), JsxString(), JsTemplateChunkElement() } as $s where {
  $s <: r"(?s).*(?:#[0-9a-fA-F]{3,8}\b|\brgba?\(|\bhsla?\(|\boklch\(|\bcolor-mix\().*",
  register_diagnostic(
    span = $s,
    message = "No colour literals in code. Colours live in packages/ui/src/styles/opendash-theme.css; use a token class, or @opendash/ui/tokens outside the browser."
  )
}

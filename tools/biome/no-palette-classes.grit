engine biome(1.0)
language js(typescript, jsx)

or { JsStringLiteralExpression(), JsxString(), JsTemplateChunkElement() } as $s where {
  or {
    $s <: r"(?s).*\b(?:bg|text|border|ring|fill|stroke|from|via|to|outline|divide|placeholder|accent|caret|decoration|shadow)-(?:slate|gray|zinc|neutral|stone|red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose|white|black)(?:-[0-9]{2,3})?\b.*",
    $s <: r"(?s).*\btext-(?:xs|sm|base|lg|xl|[2-9]xl)\b.*"
  },
  register_diagnostic(
    span = $s,
    message = "Use theme tokens, not Tailwind's palette or default type sizes (e.g. text-muted, bg-surface, text-body, text-label)."
  )
}

# Copy to .env.local (git-ignored) and fill it in. Never commit real values.
# This file is for development. Self-hosting with the root docker-compose.yml uses infra/selfhost.env.example.

# Postgres (infra/docker-compose.yml exposes 127.0.0.1:5444). Roles are created by `pnpm db:bootstrap`.
DATABASE_URL=postgres://opendash_app:opendash@127.0.0.1:5444/opendash
DATABASE_POOLED=false
DATABASE_SYSTEM_URL=postgres://opendash_system:opendash@127.0.0.1:5444/opendash
DATABASE_AUTH_URL=postgres://opendash_auth:opendash@127.0.0.1:5444/opendash
DATABASE_OWNER_URL=postgres://opendash_owner:opendash@127.0.0.1:5444/opendash
DATABASE_ADMIN_URL=postgres://opendash_owner:opendash@127.0.0.1:5444/opendash
# Optional: the ClickHouse admin for `pnpm demo:seed --clickhouse` (tests use TEST_CLICKHOUSE_ADMIN_URL). Defaults to the local
# opt-in server from `pnpm clickhouse:up` (http://opendash_owner:opendash@127.0.0.1:8124).
CLICKHOUSE_ADMIN_URL=
# Optional: the MySQL admin for `pnpm demo:seed --mysql` (tests use TEST_MYSQL_ADMIN_URL). Defaults to the local
# `pnpm mysql:up` one.
MYSQL_ADMIN_URL=
# Direct (non-pooler) connection for LISTEN/NOTIFY.
DATABASE_DIRECT_URL=postgres://opendash_app:opendash@127.0.0.1:5444/opendash
# pg-boss, as the role that owns the pgboss schema. Direct or session-mode, never a transaction pooler.
DATABASE_QUEUE_URL=postgres://opendash_queue:opendash@127.0.0.1:5444/opendash

# Role passwords for `pnpm db:bootstrap`. Required for any non-local database; local databases default to "opendash".
OPENDASH_DB_OWNER_PASSWORD=
OPENDASH_DB_APP_PASSWORD=
OPENDASH_DB_SYSTEM_PASSWORD=
OPENDASH_DB_AUTH_PASSWORD=
OPENDASH_DB_QUEUE_PASSWORD=
# Self-host setup (apps/worker scripts/setup.ts): true = seed the sample company once as `opendash_demo`, with a
# read-only opendash_demo_reader on this password. Development uses `pnpm demo:seed` instead.
OPENDASH_SEED_DEMO=
OPENDASH_DEMO_READER_PASSWORD=

# Better Auth. Required in every environment (it signs sessions and email links): openssl rand -base64 32. The worker
# needs it too: it signs the unsubscribe links in the emails it sends.
BETTER_AUTH_SECRET=
# The web app's origin. The worker uses it too, for the links in the emails it sends (weekly digests).
BETTER_AUTH_URL=http://localhost:3000
# Production: comma-separated exact HTTPS origins.
BETTER_AUTH_TRUSTED_ORIGINS=
# Addresses the app moved from (comma-separated host names): their pages open at the same path on BETTER_AUTH_URL;
# what other services call there (/api/: Slack, sign-ins coming back) is still answered until they're moved over.
OPENDASH_OLD_HOSTS=
# 1 = only invited emails can register, after the first sign-up on an instance nobody has joined yet.
OPENDASH_INVITE_ONLY=0
# Which worker pools this process runs: all (default), or a comma-separated list of query, sync, interactive.
# WORKER_POOLS=all
# The master key's reference, kept with what it encrypts so a later rotation can tell keys apart. Leave it unset.
# OPENDASH_KEK_REF=local:v1
# The Enterprise license (ee/README.md). Outside production the enterprise features need none.
# OPENDASH_LICENSE_KEY=
# Days the audit log keeps its events: 90 on every instance; up to 2562 (seven years) with a license that covers the
# audit chain. A key that lapses never shortens it.
# OPENDASH_AUDIT_RETENTION_DAYS=90
# Single sign-on (ee/README.md): hours before people at a domain that requires it sign in through their identity
# provider again (default 12), and origins to trust beyond the public internet (an identity provider on your own
# network; comma-separated, https in production).
# OPENDASH_SSO_MAX_AUTH_AGE_HOURS=12
# OPENDASH_SSO_TRUSTED_IDP_ORIGINS=
# Which sign-in screen and footer to show: community (default, self-host) or cloud.
OPENDASH_EDITION=community
# Dashboards: where their frames are served from, an origin of their own (another domain pointed at this server), so a
# dashboard's code never runs where OpenDash's session does. Required in production; in development it's the other
# loopback name of this server (http://127.0.0.1:3000 for http://localhost:3000).
# OPENDASH_FRAMES_URL=https://frames.example.com
# MCP connections (approved MCP servers, each person's own account or one shared one): on. 0 turns them off on this
# deployment (Settings hides them, the analyst isn't offered them, nothing calls a server).
# OPENDASH_MCP=0
# The component gallery at /dev/ui, which production hides: 1 shows it there too.
# OPENDASH_DEV_GALLERY=1
# Cloud only: the workers' static outbound IPs, shown on the connect form so customers can allowlist them.
OPENDASH_EGRESS_IPS=
# A Postgres that signs with its own certificate authority (ClickHouse Managed Postgres, Amazon RDS): its CA as PEM
# text, trusted by both images (or mount the file and set NODE_EXTRA_CA_CERTS). Use sslmode=verify-full in the URLs.
OPENDASH_EXTRA_CA_CERTS=
# Behind a proxy that appends to X-Forwarded-For: its addresses or CIDR ranges, comma-separated, so rate limits use
# the client's IP. Optionally, other headers to read the client IP from (e.g. x-real-ip).
OPENDASH_TRUSTED_PROXIES=
OPENDASH_CLIENT_IP_HEADERS=
# Optional links for the auth footer and the sign-up terms line. Leave empty to hide them.
OPENDASH_TERMS_URL=
OPENDASH_PRIVACY_URL=
OPENDASH_SECURITY_URL=
# Where people get help on this instance, each optional and hidden when empty: an address to write to (the auth footer,
# the account menu, the not-found page and every email's footer: set it on the worker too, which sends email), the
# docs, and a status page.
OPENDASH_SUPPORT_EMAIL=
OPENDASH_DOCS_URL=
OPENDASH_STATUS_URL=

# Email (Resend). Required in production for sign-up, sign-in and password reset. Keep real keys in .env.local.
# EMAIL_FROM is a sender on a domain verified in Resend, e.g. OpenDash <auth@yourdomain.com>.
RESEND_API_KEY=
EMAIL_FROM=
# Or, instead of Resend, an SMTP server (self-hosting): smtp://user:pass@host:587 or smtps://…:465; TLS is required
# unless the URL ends in ?requireTLS=false. Resend wins when both are set.
# For development, `pnpm mail:up` starts a local inbox (Mailpit, http://127.0.0.1:8027) that relays nothing: leave
# RESEND_API_KEY empty and set SMTP_URL=smtp://127.0.0.1:1027?requireTLS=false.
SMTP_URL=

# Slack: every workspace adds OpenDash with Add to Slack. Create the app from the manifest
# `pnpm slack:manifest https://<address>` prints, then set its Client ID, Client Secret and Signing Secret from Basic
# Information. Slack only calls https: SLACK_PUBLIC_URL is where it reaches OpenDash when that isn't BETTER_AUTH_URL
# (locally, a tunnel to the web app: `pnpm slack:tunnel` opens one). SLACK_APP_TOKEN (xapp-…, connections:write) only
# for Socket Mode, a deployment Slack can't send events to. Keep real values in .env.local.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_PUBLIC_URL=
SLACK_APP_TOKEN=

# OpenDash's own AI provider: the deployment's keys. With a Vercel AI Gateway key, every allowed model runs
# through the gateway; without one, each maker's own key runs its models. Workspaces can add their own providers in
# Settings → AI. Set them on the worker (which calls the providers) and on the web app too (which offers only the
# models that can run).
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Self-host key-encryption key for org data keys (32 bytes, base64)
OPENDASH_KEK=

# Traces (optional): the worker and the web app export OpenTelemetry over OTLP/HTTP when this is set, e.g.
# http://127.0.0.1:4318. Spans carry ids, routes, timings and usage, never a question, its SQL, an answer or a URL's
# query string.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
# Product analytics (optional, off when empty): a PostHog project key turns on a few funnel events from the server
# (signed up, workspace created, source connected, question asked and how it ended, dashboard published, invitations,
# each new alert), unhandled server errors (type and stack only, never the message) and, through this server's /ingest, page views, masked clicks,
# web vitals and errors from the browser. Ids only: no names, emails, questions, SQL or values; no cookies.
# Set it on web and on the worker (the worker sends how questions end, alerts and its own crash).
# POSTHOG_HOST defaults to PostHog's EU cloud (https://eu.i.posthog.com); set it for a PostHog of your own.
POSTHOG_KEY=
POSTHOG_HOST=

# Self-host settings for the root docker-compose.yml (docs/operations/HOSTING.md). Copy to .env next to it and
# fill it in. Never commit the copy.
#
# Passwords go into connection URLs: use URL-safe ones, e.g. `openssl rand -hex 24` for each.

# Postgres's own superuser, used by `setup` only (it creates OpenDash's roles, schemas and extensions).
POSTGRES_PASSWORD=
# OpenDash's database roles (created by `setup` with these passwords).
OPENDASH_DB_OWNER_PASSWORD=
OPENDASH_DB_APP_PASSWORD=
OPENDASH_DB_SYSTEM_PASSWORD=
OPENDASH_DB_AUTH_PASSWORD=
OPENDASH_DB_QUEUE_PASSWORD=

# The master key-encryption key for stored connection passwords and model keys (32 bytes, base64):
# openssl rand -base64 32. Back it up: without it, stored secrets can't be recovered.
OPENDASH_KEK=
# Signs sessions and email links: openssl rand -base64 32.
BETTER_AUTH_SECRET=
# The HTTPS address people open OpenDash at, and the exact HTTPS origins allowed to sign in (comma-separated), e.g.
# https://opendash.example.com for both. Sign-in refuses plain HTTP, so a proxy with TLS goes in front: yours, or the
# caddy profile below.
BETTER_AUTH_URL=
BETTER_AUTH_TRUSTED_ORIGINS=
# Where dashboards are drawn: an HTTPS origin of its own on the same server, so a dashboard's code never runs where
# OpenDash's sign-in does, e.g. https://frames.opendash.example.com. Point its DNS here like the main address (the
# caddy profile serves frames.<OPENDASH_DOMAIN> for it). Without it, dashboards can't open.
OPENDASH_FRAMES_URL=
# With `docker compose --profile caddy up -d`: the domain Caddy gets a certificate for (its DNS pointing here), or
# localhost to try it on this machine (Caddy's own certificate, which the browser asks you to trust). Then
# BETTER_AUTH_URL is https://<this domain>, with :<port> when OPENDASH_HTTPS_PORT isn't 443.
OPENDASH_DOMAIN=
# Dashboards' host for Caddy, frames.<OPENDASH_DOMAIN> unless set; OPENDASH_FRAMES_URL is https://<this host>.
OPENDASH_FRAMES_DOMAIN=
OPENDASH_HTTP_PORT=
OPENDASH_HTTPS_PORT=

# Email: sign-up, sign-in and password reset need it; the web app won't start without EMAIL_FROM and one of the two
# below. EMAIL_FROM is the sender, e.g. OpenDash <auth@example.com>, on a domain your provider lets you send from.
EMAIL_FROM=
# Either Resend's API key (the domain verified in Resend)…
RESEND_API_KEY=
# …or any SMTP server: smtp://user:pass@mail.example.com:587 (STARTTLS) or smtps://user:pass@mail.example.com:465.
# TLS is required; only a URL ending in ?requireTLS=false sends in plain text (a mail sink on this machine).
SMTP_URL=

# Slack (optional): create the app from the manifest `pnpm slack:manifest https://<this address> --socket`
# prints (Socket Mode: Slack needs no public address for events), then set its keys from Basic Information and an
# app-level token with connections:write. Owners and admins then use Settings → Slack → Add to Slack.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
# Only when Add to Slack must come back to another https address than BETTER_AUTH_URL's.
SLACK_PUBLIC_URL=

# OpenDash's own AI provider: the deployment's keys. With a Vercel AI Gateway key every allowed model runs through it;
# without one, each maker's key runs its models. Workspaces can add their own providers in Settings → AI.
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional.
# The Enterprise license, checked offline (ee/README.md): single sign-on, directory sync and the audit log's chain
# and exports. Without it, OpenDash runs as the open core.
OPENDASH_LICENSE_KEY=
# Days the audit log keeps its events: 90 without a license; up to 2562 (seven years) with one that covers the audit
# chain. A key that lapses never shortens it.
OPENDASH_AUDIT_RETENTION_DAYS=
# Single sign-on (ee/README.md): hours before people at a domain that requires it sign in through their identity
# provider again (default 12), and origins to trust beyond the public internet (an identity provider on your own
# network; comma-separated, https in production).
OPENDASH_SSO_MAX_AUTH_AGE_HOURS=
OPENDASH_SSO_TRUSTED_IDP_ORIGINS=
# true = seed the sample company (Acme) once, as its own database `opendash_demo` with a read-only user
# opendash_demo_reader (this password), to try OpenDash on: connect it on Data → Connect source, host `postgres`.
OPENDASH_SEED_DEMO=
OPENDASH_DEMO_READER_PASSWORD=
# Where the web app listens on this machine: 127.0.0.1:3000 by default, behind a proxy you run.
OPENDASH_BIND=
OPENDASH_PORT=
# Who can join. 1 (the default) = the first person to sign up, then only people they or other members invite.
# 0 = anyone who can reach this address can sign up, make workspaces on this server's model keys and connect
# sources on its network.
OPENDASH_INVITE_ONLY=1
# A Postgres that signs with its own certificate authority (ClickHouse Managed Postgres, Amazon RDS): its CA as PEM
# text, trusted by both images (or mount the file and set NODE_EXTRA_CA_CERTS). Use sslmode=verify-full in the URLs.
OPENDASH_EXTRA_CA_CERTS=
# Behind a proxy that appends to X-Forwarded-For: its addresses or ranges, so rate limits count per client.
OPENDASH_TRUSTED_PROXIES=
OPENDASH_CLIENT_IP_HEADERS=
# Optional, each hidden when empty: the address people write to for help (shown in the app and at the foot of every
# email), your docs and status page, and the links for the sign-up terms line and the auth footer.
OPENDASH_SUPPORT_EMAIL=
OPENDASH_DOCS_URL=
OPENDASH_STATUS_URL=
OPENDASH_TERMS_URL=
OPENDASH_PRIVACY_URL=
OPENDASH_SECURITY_URL=
# Traces to an OpenTelemetry collector (no prompts, SQL or answers are sent).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Published images instead of building here, e.g. ghcr.io/getopendash/opendash-web:v1.2.3 and …/opendash-worker:v1.2.3.
OPENDASH_WEB_IMAGE=
OPENDASH_WORKER_IMAGE=
